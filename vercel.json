        { "type": "host", "value": "muditam-app-dashboard.vercel.app" }
      ],
      "destination": "https://chat.muditam.com/widget/dashboard",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
