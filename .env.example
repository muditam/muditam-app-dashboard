VITE_API_BASE_URL=http://localhost:3001
# Must match DASHBOARD_API_KEY on the backend in production.
VITE_DASHBOARD_API_KEY=

# Shared platform authentication. Keep login cookies on the same API as other apps.
# VITE_SHIPTRACK_API_URL=https://shiptrack-api.60brands.com
# Local Vite proxy target (server-side only):
SHIPTRACK_API_BASE_URL=http://localhost:4000
# Local widget proxy target; set to a running local app backend when testing changes.
# WIDGET_API_BASE_URL=http://localhost:3001
# To compare against chat.60brands.com, that backend must use the live backend's
# AI_PLATFORM_BASE_URL and AI_PLATFORM_SERVICE_SECRET. A local AI service can
# use a separate analytics store and will show different conversations/leads.
# Keep those credentials in the backend environment, never in VITE_ variables.
# ShipTrack API and muditam-app-backend both require the same server-only
# APP_DASHBOARD_TOKEN_SECRET (at least 32 characters). Never use a VITE_ secret.
